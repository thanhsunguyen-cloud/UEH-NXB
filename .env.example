# Cấu hình môi trường mẫu cho UEH Publishing Portal V2 (M0)
# Sao chép thành .env khi chạy cục bộ. KHÔNG đưa giá trị bí mật vào repository.

DJANGO_SECRET_KEY=replace-with-random-secret-key-min-50-chars
DJANGO_DEBUG=True
DATABASE_URL=postgres://ueh_portal:ueh_portal@db:5432/ueh_portal
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Đăng nhập Google OAuth cho nhân sự (@ueh.edu.vn)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STAFF_GOOGLE_DOMAIN=ueh.edu.vn

# Danh sách tối đa 2 email Admin khởi tạo bởi `python manage.py bootstrap_admin`
BOOTSTRAP_ADMIN_EMAILS=admin@ueh.edu.vn

# Lưu trữ tệp: local (mặc định) hoặc gdrive (Shared Drive của NXB, gói M1)
FILE_STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MAX_FILE_MB=200
# Dung lượng tối đa (MiB) của file thư viện không thuộc hồ sơ (biểu mẫu, ảnh công khai)
MAX_LIBRARY_FILE_MB=10

# Google Drive (chỉ dùng khi FILE_STORAGE_BACKEND=gdrive)
# ID của Shared Drive nơi service account có vai trò Content Manager
GDRIVE_SHARED_DRIVE_ID=
# Đường dẫn file JSON của service account; để trống = dùng Application Default Credentials (Cloud Run)
GDRIVE_CREDENTIALS_FILE=

# Email (môi trường phát triển trỏ tới Mailpit)
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=nxbkt@ueh.edu.vn
